PORT=3000
# Set this to the URL teachers actually use to reach the app.
# Examples:
#   http://192.168.1.50:3005
#   https://seating.example.org
BETTER_AUTH_URL=http://localhost:3005

# Generate with:
# node --input-type=module -e "import crypto from 'node:crypto'; console.log(crypto.randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
